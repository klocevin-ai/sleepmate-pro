rules_version = '2';
// ============================================================
//  SLEEPMATE Pro — Firestore Security Rules (v3.2)
//  ------------------------------------------------------------
//  QUAN TRỌNG: thay "DAN_VAO_DAY_EMAIL_ADMIN" bên dưới bằng
//  ĐÚNG email admin của bạn (giống email bạn đã điền trong
//  file firebase-config.js -> SLEEPMATE_ADMIN_EMAILS).
//
//  Nguyên tắc:
//   - Thành viên chỉ đọc/ghi dữ liệu CỦA CHÍNH MÌNH.
//   - Không ai được tự phong mình làm admin (vai trò 'admin'
//     chỉ dành cho email nằm trong danh sách bên dưới).
//   - Admin (email trong danh sách) đọc được mọi người dùng,
//     gửi inbox, cài luật nhóm config/groupRules.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin = email trong danh sách cứng bên dưới.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && string(request.auth.token.email).lower() in ['DAN_VAO_DAY_EMAIL_ADMIN'];
    }

    // Thành viên khi tự tạo hồ sơ chỉ được phép ghi các trường
    // cơ bản và BẮT BUỘC vai trò là 'member' (không thể tự nâng admin).
    function validUserCreate() {
      return request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'role', 'createdAt', 'lastSeenAt'
        ])
        && request.resource.data.role == 'member'
        && request.resource.data.uid == request.auth.uid;
    }

    // Cập nhật hồ sơ: admin toàn quyền; chủ sở hữu chỉ được
    // cập nhật các trường thông tin của mình, không được đổi vai trò.
    function validUserUpdate() {
      return !('role' in request.resource.data)
        || request.resource.data.role == 'member';
    }

    match /users/{uid} {
      allow get, list: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || validUserCreate();
      allow update: if isAdmin() || (isOwner(uid) && validUserUpdate());
      allow delete: if isAdmin();

      // Dữ liệu giấc ngủ theo ngày
      match /days/{day} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }

      // Lịch sử các lần khoá máy
      match /locks/{lock} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow delete: if isAdmin();
      }

      // Hộp thư: Admin gửi vào, chủ sở hữu đọc & đánh dấu đã đọc
      match /inbox/{msg} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin();
        allow update, delete: if isOwner(uid) || isAdmin();
      }
    }

    // Luật chung do Admin quản lý
    match /config/groupRules {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}